# Opt-in fragment after rockchip_defconfig, not a complete board config.
# This constrains a generic SDK build; it does not prove flash preservation.
# CONFIG_RK_NAND is not set
# CONFIG_MTD is not set
# CONFIG_BT is not set
CONFIG_HOTPLUG_CPU=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_EFI_PARTITION=y
