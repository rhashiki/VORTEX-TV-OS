# Apply to upstream evb-rk3229_defconfig at the recorded v2024.01 commit.
CONFIG_DEFAULT_DEVICE_TREE="rk3229-vortex-sd-reference"
CONFIG_OF_LIST="rk3229-vortex-sd-reference"
CONFIG_DEFAULT_FDT_FILE="rk3229-vortex-sd-reference.dtb"
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_MMC is not set
CONFIG_USE_DEFAULT_ENV_FILE=y
CONFIG_DEFAULT_ENV_FILE="board/rockchip/evb_rk3229/vortex-sd-reference.env"
CONFIG_BOOTDELAY=-1
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="echo Vortex SD reference components only"
# CONFIG_BOOTSTD is not set
# CONFIG_BOOTSTD_DEFAULTS is not set
# CONFIG_USE_PREBOOT is not set
# CONFIG_DISTRO_DEFAULTS is not set
CONFIG_ROCKCHIP_BOOT_MODE_REG=0x0
CONFIG_OPTEE_LIB=y
# CONFIG_MMC_WRITE is not set
# CONFIG_SPL_MMC_WRITE is not set
# CONFIG_MMC_HW_PARTITIONING is not set
# CONFIG_SUPPORT_EMMC_BOOT is not set
# CONFIG_CMD_MMC is not set
# CONFIG_CMD_GPT is not set
# CONFIG_CMD_SAVEENV is not set
# CONFIG_CMD_ERASEENV is not set
# CONFIG_CMD_ENV_SAVE is not set
# CONFIG_CMD_MEMORY is not set
# CONFIG_CMD_MEMTEST is not set
# CONFIG_CMD_EEPROM is not set
# CONFIG_CMD_FLASH is not set
# CONFIG_CMD_SF is not set
# CONFIG_CMD_NAND is not set
# CONFIG_CMD_FASTBOOT is not set
# CONFIG_CMD_USB_MASS_STORAGE is not set
# CONFIG_CMD_ROCKUSB is not set
# CONFIG_CMD_DFU is not set
# CONFIG_DFU is not set
# CONFIG_FASTBOOT is not set
# CONFIG_USB_FUNCTION_FASTBOOT is not set
# CONFIG_FASTBOOT_FLASH is not set
# CONFIG_USB is not set
# CONFIG_USB_GADGET is not set
# CONFIG_NET is not set
# CONFIG_MTD is not set
# CONFIG_CMD_FS_GENERIC is not set
# CONFIG_CMD_EXT4_WRITE is not set
# CONFIG_CMD_FAT is not set
# CONFIG_EFI_LOADER is not set
CONFIG_SPL_PINCTRL=y
CONFIG_SPL_PINCTRL_FULL=y
CONFIG_OF_SPL_REMOVE_PROPS="clock-names interrupt-parent assigned-clocks assigned-clock-rates assigned-clock-parents"
