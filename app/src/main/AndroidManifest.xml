<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" package="os.vortex.tv">
    <!-- Also required by the AOSP make build, which does not read app/build.gradle. -->
    <uses-sdk android:minSdkVersion="25" android:targetSdkVersion="25" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- Platform permissions: ROM must grant these; ordinary APKs cannot reboot/shut down. -->
    <uses-permission android:name="android.permission.REBOOT" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SHUTDOWN" tools:ignore="ProtectedPermissions" />
    <!-- Official full-resolution artwork is not mounted yet; do not ship previews or redraw it.
         Remove this temporary MissingTvBanner exemption when verified official resources land. -->
    <application android:allowBackup="false" android:usesCleartextTraffic="false"
        android:label="Vortex TV OS" android:theme="@style/Theme.Vortex"
        tools:ignore="MissingTvBanner"
        android:hasCode="true" android:supportsRtl="true">
        <activity android:name=".HomeActivity" android:exported="true"
            android:screenOrientation="landscape" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".InstallerActivity" android:exported="false" android:screenOrientation="landscape" />
        <receiver android:name=".InstallResultReceiver" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" android:screenOrientation="landscape" />
    </application>
</manifest>
